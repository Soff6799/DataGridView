@model NailWarehouse.Models.Product

@{
    ViewData["Title"] = "Редактировать продукт";
    var standardSizes = new List<string> { "2.0x35", "2.5x50", "3.0x70", "3.5x90", "4.0x100", "4.5x120" };
    var isCustomSize = !string.IsNullOrEmpty(Model.Size) && !standardSizes.Contains(Model.Size);

    // Проверяем, является ли материал стандартным
    var standardMaterials = new List<string> { "медь", "сталь", "железо", "хром" };
    var isCustomMaterial = !string.IsNullOrEmpty(Model.Material) && !standardMaterials.Contains(Model.Material);
}

<div class="container mt-5" style="max-width: 600px;">
    <div class="card shadow">
        <div class="card-header bg-secondary text-white text-center py-3">
            <h3 class="mb-0 fw-bold">Редактирование продукта</h3>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold">Название продукта</label>
                    <input asp-for="Name" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Size" class="form-label fw-semibold">Размер</label>

                    <select class="form-select" id="selectSize" name="@(isCustomSize ? "" : "Size")" required>
                        <option value="" disabled>Выберите размер...</option>
                        <option value="2.0x35" selected="@(Model.Size == "2.0x35")">2.0x35</option>
                        <option value="2.5x50" selected="@(Model.Size == "2.5x50")">2.5x50</option>
                        <option value="3.0x70" selected="@(Model.Size == "3.0x70")">3.0x70</option>
                        <option value="3.5x90" selected="@(Model.Size == "3.5x90")">3.5x90</option>
                        <option value="4.0x100" selected="@(Model.Size == "4.0x100")">4.0x100</option>
                        <option value="4.5x120" selected="@(Model.Size == "4.5x120")">4.5x120</option>
                        <option value="Other" selected="@isCustomSize">Другое...</option>
                    </select>

                    <input type="text" id="inputCustomSize"
                           name="@(isCustomSize ? "Size" : "")"
                           value="@(isCustomSize ? Model.Size : "")"
                           class="form-control mt-2 @(isCustomSize ? "" : "d-none")"
                           placeholder="Введите свой размер" />
                </div>

                <div class="mb-3">
                    <label asp-for="Material" class="form-label fw-semibold">Материал</label>

                    <select class="form-select" id="selectMaterial" name="@(isCustomMaterial ? "" : "Material")" required>
                        <option value="" disabled>Выберите материал...</option>
                        <option value="медь" selected="@(Model.Material == "медь")">медь</option>
                        <option value="сталь" selected="@(Model.Material == "сталь")">сталь</option>
                        <option value="железо" selected="@(Model.Material == "железо")">железо</option>
                        <option value="хром" selected="@(Model.Material == "хром")">хром</option>
                        <option value="Other" selected="@isCustomMaterial">Другое...</option>
                    </select>

                    <input type="text" id="inputCustomMaterial"
                           name="@(isCustomMaterial ? "Material" : "")"
                           value="@(isCustomMaterial ? Model.Material : "")"
                           class="form-control mt-2 @(isCustomMaterial ? "" : "d-none")"
                           placeholder="Введите свой материал" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Quantity" class="form-label fw-semibold">Количество</label>
                        <input asp-for="Quantity" type="number" class="form-control" required min="0" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="MinQuantity" class="form-label fw-semibold">Мин. количество</label>
                        <input asp-for="MinQuantity" type="number" class="form-control" required min="0" />
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Price" class="form-label fw-semibold">Цена (за шт./уп.)</label>
                    <div class="input-group">
                        <input asp-for="Price" type="number" step="0.01" class="form-control" required min="0" />
                        <span class="input-group-text">руб.</span>
                    </div>
                </div>

                <div class="d-flex justify-content-between gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Отмена</a>
                    <button type="submit" class="btn btn-success px-5">Сохранить</button>
                </div>
            </form>
        </div>
    </div>
</div>
